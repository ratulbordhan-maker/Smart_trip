# Backend API URL (development)
REACT_APP_API_URL=http://localhost:8081

# Backend API URL (production)
# REACT_APP_API_URL=https://api.yourdomain.com

# Razorpay Keys (for payment integration)
REACT_APP_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_HERE
REACT_APP_RAZORPAY_KEY_SECRET=rzp_live_YOUR_SECRET_HERE

# Analytics (optional)
REACT_APP_GOOGLE_ANALYTICS_ID=

# Feature Flags
REACT_APP_ENABLE_PAYMENTS=true
REACT_APP_ENABLE_WISHLIST=true
REACT_APP_ENABLE_REVIEWS=true
